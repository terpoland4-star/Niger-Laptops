# Application
NODE_ENV=development
PORT=3000
APP_NAME=Niger Laptops API
APP_URL=http://localhost:3000

# Base de données
DB_HOST=localhost
DB_PORT=5432
DB_NAME=niger_laptops
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=super_secret_key_change_me_at_least_32_chars
JWT_REFRESH_SECRET=another_secret_key_change_me
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+22700000000

# Orange Money
OM_API_KEY=your_orange_money_api_key
OM_API_SECRET=your_orange_money_api_secret
OM_MERCHANT_ID=your_merchant_id

# Airtel Money
AM_API_KEY=your_airtel_money_api_key
AM_API_SECRET=your_airtel_money_api_secret

# MyNita
MYNITA_API_KEY=votre_cle_api_mynita

# AmanaTa
AMANATA_API_KEY=votre_cle_api_amanata

# Carte bancaire (ex: PayDunya)
CARD_API_KEY=votre_cle_api_paydunya
CARD_API_SECRET=votre_secret_paydunya

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=niger-laptops

# Frontend
MOBILE_APP_SCHEME=nigerlaptops://
ADMIN_URL=http://localhost:4000
