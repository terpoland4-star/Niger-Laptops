{
  "name": "niger-laptops-api",
  "version": "1.0.0",
  "description": "API e-commerce Niger Laptops - Boutique en ligne de consommables informatiques",
  "main": "dist/index.js",
  "author": "Hamadine AG MOCTAR",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/config/seed.ts",
    "db:up": "docker-compose up -d postgres redis minio",
    "db:down": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d postgres redis minio",
    "lint": "eslint src/",
    "test": "jest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.14.1",
    "redis": "^4.7.0",
    "sharp": "^0.33.5",
    "twilio": "^5.5.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.12",
    "@types/uuid": "^11.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
